{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"types": ["node"]
	}
}
